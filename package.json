{
  "name": "optix",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @optix/db migrate",
    "db:studio": "pnpm --filter @optix/db studio",
    "db:generate": "pnpm --filter @optix/db generate",
    "db:provision": "pnpm --filter @optix/db provision"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
