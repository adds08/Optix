    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@optix/config-tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "esbuild": "^0.24.0"
  }
