# Production image for the intent parser.
#
# Stateless: no database, no auth, no tenant logic. It assembles a prompt,
# calls an OpenAI-compatible endpoint and parses the JSON back. That is the
# whole service — which is worth remembering when deciding whether it still
# earns its own container once inference is remote.
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENGINE_PORT=4600

WORKDIR /app

COPY engine/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY engine/ ./

# Non-root, same reasoning as the node images.
RUN useradd --create-home --shell /bin/false engine && chown -R engine:engine /app
USER engine

EXPOSE 4600

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,os,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('ENGINE_PORT','4600')+'/health', timeout=4).status==200 else 1)"

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${ENGINE_PORT:-4600}"]
