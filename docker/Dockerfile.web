# Production image for apps/web (Next.js 15).
#
# `output: "standalone"` in next.config.mjs traces exactly the files the server
# needs and copies them into .next/standalone, so the runtime layer carries no
# pnpm store and no source. The workspace packages are handled by
# `transpilePackages`, so Next compiles their TypeScript itself — this app does
# not have the raw-.ts problem apps/api had.
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.11.0 --activate
WORKDIR /workspace

FROM base AS deps
# Manifests only, so `pnpm install` is cached against dependency changes rather
# than source changes. The cost of that is this list: a NEW WORKSPACE PACKAGE
# MUST BE ADDED HERE or pnpm never links it, and the build fails much later
# with a misleading "Cannot find module '@stinventory/types'" from inside the
# package that was missed.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/intent/package.json packages/intent/
COPY packages/api-contracts/package.json packages/api-contracts/
COPY packages/auth/package.json packages/auth/
COPY packages/env/package.json packages/env/
COPY packages/logger/package.json packages/logger/
# `mail` is a transitive dependency of `api-contracts`, not of `web` — which is
# exactly why it was missed. This image installs the whole workspace from one
# lockfile, so a package `web` never imports still has to be linkable.
COPY packages/mail/package.json packages/mail/
COPY packages/types/package.json packages/types/
# `design-system` was deleted (with `frontend-shared`) after going unimported by
# either client — its COPY line outlived it and broke this image. A removed
# workspace package needs its manifest COPY removed here, exactly as a new one
# needs it added.
COPY packages/config-eslint/package.json packages/config-eslint/
COPY packages/config-tsconfig/package.json packages/config-tsconfig/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json turbo.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/
# Baked in at build time: NEXT_PUBLIC_* are inlined into the client bundle, so
# they cannot be supplied at run time like ordinary env vars.
ARG NEXT_PUBLIC_API_URL=http://localhost:4100
# Every NEXT_PUBLIC_* the app reads has to be declared here as well as passed in
# compose. An arg the Dockerfile does not declare is simply absent at build
# time, and `process.env.X === "1"` then compiles to false with no warning —
# which is how the demo-login flag was silently dropped.
ARG NEXT_PUBLIC_SHOW_DEMO_LOGINS=0
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SHOW_DEMO_LOGINS=$NEXT_PUBLIC_SHOW_DEMO_LOGINS
ENV NEXT_TELEMETRY_DISABLED=1
# The production droplet is 1GB of RAM. Next's build workers happily balloon
# past that and the box OOMs mid-deploy (see the 2026-08-02 command-center
# changelog). Cap the heap and build with a single worker so the build fits
# in RAM + swap instead of thrashing it.
ENV NODE_OPTIONS=--max-old-space-size=1536
ENV NEXT_BUILD_WORKERS=1
RUN pnpm --filter @stinventory/web build
# `public/` is optional in Next and this app has none today. Creating it keeps
# the COPY below unconditional, so adding static assets later needs no
# Dockerfile change and its absence never fails the build.
RUN mkdir -p /workspace/apps/web/public

FROM base AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3100

COPY --from=build /workspace/apps/web/.next/standalone ./
COPY --from=build /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /workspace/apps/web/public ./apps/web/public

RUN chown -R node:node /workspace
USER node
EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3100)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
