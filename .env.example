# STInventory — env template. Copy to .env.local and edit.
# docker-compose loads this via `make ENV=local up` -> --env-file .env.local.

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=stinventory
POSTGRES_DB=stinventory
POSTGRES_PORT=5433

# ---- Ports (host-side) -------------------------------------------------------
API_PORT=4100
WEB_PORT=3100

# ---- API ---------------------------------------------------------------------
# Must be 32+ chars. The API REFUSES to start with NODE_ENV=production while
# this example value is in place — generate one with `openssl rand -hex 32`.
SESSION_SECRET=stinventory-dev-secret-please-change-to-32-chars-minimum
WEB_ORIGIN=http://localhost:3100

# ---- Notification engine -----------------------------------------------------
# SMTP (transactional email). Leave empty to log to console instead of sending.
# For LOCAL development, `make ENV=local up` runs a Mailpit container that
# accepts all mail, delivers none of it, and serves the inbox at
# http://localhost:8025. Point these at it to test the invite -> signup ->
# onboarding loop with a real clickable link:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
# Left EMPTY here on purpose: empty means `sendMail` logs to the console
# instead of sending, which is the right default for a deployed environment
# that has not been given real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Optix <donotreply@optixtec.com>"

# ---- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4100

# ---- LLM (intent parsing) ---------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Examples:
#   OpenAI:       https://api.openai.com/v1            + gpt-4o-mini
#   DigitalOcean: https://inference.do-ai.run/v1       + openai-gpt-4o-mini
#   Groq (free):  https://api.groq.com/openai/v1       + llama-3.3-70b-versatile
#   Local (oMLX): http://host.docker.internal:8088/v1  + gemma-4-E2B-it-MLX-6bit
#
# These are only the fallback. A tenant's Settings page overrides every one of
# them (see tenant_settings.llm_*), and that is the intended way to configure a
# deployed instance — the key is encrypted at rest and changeable without an
# ssh session. Leave these empty on a server that has Settings filled in.
#
# The API runs in Docker, so a model server on the Mac host must be reached via
# host.docker.internal, NOT localhost. Local models need a longer timeout —
# a 2B MLX model takes 4-8s per parse against the ~3k-char system prompt.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000

# ---- Mobile (Expo) ----------------------------------------------------------
# Mobile sends this as the CORS origin. For physical device testing, set to
# http://<lan-ip>:8081 or * for dev. For Expo Go, the origin varies.
MOBILE_ORIGIN=http://localhost:8081

# Must be set in the mobile app's .env or via EXPO_PUBLIC_API_URL env var at build time.
# For physical device testing: http://<laptop-lan-ip>:4100
# EXPO_PUBLIC_API_URL=http://localhost:4100

# ---- BambooHR (people sync) --------------------------------------------------
# The company subdomain, NOT the full URL: if you sign in at
# https://urbaninfra.bamboohr.com then this is `urbaninfra`. It becomes the
# {companyDomain} path segment every BambooHR request is built on.
BAMBOOHR_COMPANY_DOMAIN=

# The API key, generated from BambooHR (profile menu -> API Keys).
#
# BambooHR uses HTTP Basic auth with the key as the USERNAME and any value as
# the password — their docs use the literal string `x`. So there is no separate
# password setting here: the key alone authenticates, and the sync sends
# `Authorization: Basic base64(<key>:x)`.
#
# Scope matters. list-employees returns null for fields the key may not read
# and names them in `_restrictedFields` — a narrow key produces a thin import
# that looks like missing data rather than a permissions problem. The sync
# reports those fields rather than writing over them.
#
# Leave empty to disable the sync entirely.
BAMBOOHR_API_KEY=
