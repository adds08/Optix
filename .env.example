# STInventory — env template. Copy to .env.local and edit.
# docker-compose loads this via `make ENV=local up` -> --env-file .env.local.

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=stinventory
POSTGRES_DB=stinventory
POSTGRES_PORT=5433

# ---- Ports (host-side) -------------------------------------------------------
API_PORT=4100
WEB_PORT=3100

# ---- API ---------------------------------------------------------------------
# Must be 32+ chars. The API REFUSES to start with NODE_ENV=production while
# this example value is in place — generate one with `openssl rand -hex 32`.
SESSION_SECRET=stinventory-dev-secret-please-change-to-32-chars-minimum
WEB_ORIGIN=http://localhost:3100

# ---- Notification engine -----------------------------------------------------
# SMTP (transactional email). Leave empty to log to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STInventory <no-reply@stinventory.local>"
# SMS (twilio). Leave empty to log to console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_APP_NAME=STInventory

# ---- AI Engine --------------------------------------------------------------
# NOTE: the standalone Python engine (engine/) is not on the request path.
# apps/api calls the LLM directly — see the LLM_* block below.
ENGINE_BASE_URL=http://localhost:4600
ENGINE_TIMEOUT_MS=15000

# ---- LLM (intent parsing) ---------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Examples:
#   OpenAI:       https://api.openai.com/v1            + gpt-4o-mini
#   Groq (free):  https://api.groq.com/openai/v1       + llama-3.3-70b-versatile
#   Local (oMLX): http://host.docker.internal:8088/v1  + gemma-4-E2B-it-MLX-6bit
#
# The API runs in Docker, so a model server on the Mac host must be reached via
# host.docker.internal, NOT localhost. Local models need a longer timeout —
# a 2B MLX model takes 4-8s per parse against the ~3k-char system prompt.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000

# ---- Mobile (Expo) ----------------------------------------------------------
# Mobile sends this as the CORS origin. For physical device testing, set to
# http://<lan-ip>:8081 or * for dev. For Expo Go, the origin varies.
MOBILE_ORIGIN=http://localhost:8081

# Must be set in the mobile app's .env or via EXPO_PUBLIC_API_URL env var at build time.
# For physical device testing: http://<laptop-lan-ip>:4100
# EXPO_PUBLIC_API_URL=http://localhost:4100

# ---- Intent parser (engine/) -------------------------------------------------
# The engine speaks the OpenAI wire format, so any compatible endpoint works:
# a local Ollama / LM Studio, or a hosted serverless inference provider.
# Take the base URL and key from your provider's console.
ENGINE_LLM_BASE_URL=http://host.docker.internal:8088/v1
ENGINE_MODEL=gemma-4-E2B-it-MLX-6bit
# Never leave this as a placeholder against a paid endpoint.
ENGINE_API_KEY=1234
ENGINE_TIMEOUT_MS=15000
# Where apps/api reaches the engine (compose service name in a container run).
ENGINE_BASE_URL=http://engine:4600
ENGINE_PORT=4600
